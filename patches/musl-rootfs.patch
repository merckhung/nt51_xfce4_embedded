+	shim_debug_print("[init_tp] calling __set_thread_area\n");
 	int r = __set_thread_area(TP_ADJ(p));
+	shim_debug_print("[init_tp] __set_thread_area returned\n");
 	if (r < 0) return -1;
 	if (!r) libc.can_do_threads = 1;
 	td->detach_state = DT_JOINABLE;
-	td->tid = __syscall(SYS_set_tid_address, &__thread_list_lock);
+	td->tid = 1;
 	td->locale = &libc.global_locale;
 	td->robust_list.head = &td->robust_list.head;
 	td->sysinfo = __sysinfo;
@@ -146,8 +149,12 @@
 	}
 
 	/* Failure to initialize thread pointer is always fatal. */
-	if (__init_tp(__copy_tls(mem)) < 0)
+	shim_debug_print("[init_tls] calling __copy_tls and __init_tp\n");
+	if (__init_tp(__copy_tls(mem)) < 0) {
+		shim_debug_print("[init_tls] __init_tp FAILED!\n");
 		a_crash();
+	}
+	shim_debug_print("[init_tls] static_init_tls finished successfully!\n");
