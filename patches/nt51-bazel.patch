diff --git a/bazel/legacy/ke_services_wrapper.cmd b/bazel/legacy/ke_services_wrapper.cmd
new file mode 100644
--- /dev/null
+++ b/bazel/legacy/ke_services_wrapper.cmd
@@ -0,0 +1,14 @@
+@echo off
+setlocal
+for %%I in ("%~1") do set "TOOLDIR=%%~fI"
+set "SOURCE=%~2"
+set "OUTDIR=%~3"
+set "STUBDIR=%~4"
+if not exist "%OUTDIR%" mkdir "%OUTDIR%" || exit /b 1
+"%TOOLDIR%\cl.exe" /nologo /EP /D_X86_=1 /Di386=1 "%SOURCE%" > "%OUTDIR%\services.tab" || exit /b 1
+copy "%STUBDIR%\table.stb" "%OUTDIR%\table.stb" >nul || exit /b 1
+copy "%STUBDIR%\services.stb" "%OUTDIR%\services.stb" >nul || exit /b 1
+cd /d "%OUTDIR%"
+rem gensrv has fixed-size path buffers; use short paths inside the output directory.
+"%TOOLDIR%\gensrv.exe" -e asm -g . || exit /b 1
+exit /b 0
