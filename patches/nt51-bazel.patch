+
+; The embedded ELF runtime records its i386 TLS base in KTHREAD.TlsArray.
+; Restore GDT[12] and GS after a thread/address-space switch. This replaces
+; framebuffer-driver patches that depended on offsets in one linked kernel.
+; Native threads have a zero TlsArray and retain the original null GS.
+KiRestoreEmbeddedTls proc
+        mov     ecx, PCR[PcPrcbData+PbCurrentThread]
+        mov     eax, [ecx]+ThTlsArray
+        test    eax, eax
+        jz      short embedded_tls_clear
+        mov     ecx, PCR[PcGdt]
+        mov     word ptr [ecx+060h], 0FFFFh
+        mov     word ptr [ecx+062h], ax
+        shr     eax, 16
+        mov     byte ptr [ecx+064h], al
+        mov     byte ptr [ecx+065h], 0F3h
+        mov     byte ptr [ecx+066h], 0CFh
+        mov     byte ptr [ecx+067h], ah
+        mov     eax, 063h
+        mov     gs, ax
+        ret
+embedded_tls_clear:
+        xor     eax, eax
+        mov     gs, ax
+        ret
+KiRestoreEmbeddedTls endp
 
