diff --git a/bazel/legacy/nt5_rules.bzl b/bazel/legacy/nt5_rules.bzl
new file mode 100644
--- /dev/null
+++ b/bazel/legacy/nt5_rules.bzl
@@ -0,0 +1,897 @@
+"""Rules that invoke the original NT 5 x86 compiler and librarian."""
+
+Nt5ObjectsInfo = provider(
+    doc = "Object files emitted by an NT5 C compilation target.",
+    fields = {"objects": "depset of COFF object files"},
+)
+
+Nt5IncludeInfo = provider(
+    doc = "Generated include directory and the files that materialize it.",
+    fields = {
+        "directory": "include directory File",
+        "files": "depset containing the generated directory",
+    },
+)
+
+Nt5PchInfo = provider(
+    doc = "VC7 precompiled-header state and its companion archive object.",
+    fields = {
+        "header_name": "header basename passed to /Yu",
+        "pch": "the generated PCH file",
+        "files": "depset containing the PCH and object",
+    },
+)
+
+Nt5DefInfo = provider(fields = {"def_file": "preprocessed module-definition file"})
+Nt5ImportInfo = provider(fields = {"exp": "export object", "library": "import library"})
+
+_FREE_X86_COPTS = [
+    "/nologo",
+    "/c",
+    "/Zel",
+    "/Zp8",
+    "/Gy",
+    "/WX",
+    "/G6",
+    "/Gi-",
+    "/Gm-",
+    "/GX-",
+    "/GR-",
+    "/GF",
+    "/QIfdiv-",
+    "/QIf",
+    "/Oxs",
+    "/Gz",
+    "/Z7",
+    "/FIwarning.h",
+]
+
+_FREE_X86_DEFINES = [
+    "_X86_=1",
+    "i386=1",
+    "CONDITION_HANDLING=1",
+    "WIN32_LEAN_AND_MEAN=1",
+    "WIN32=100",
+    "_NT1X_=100",
+    "WINNT=1",
+    "_WIN32_WINNT=0x0501",
+    "WINVER=0x0501",
+    "NT_INST=0",
+    "STD_CALL=1",
+    "DEVL=1",
+]
+
+def _is_checked(ctx):
+    return ctx.var.get("nt5_checked", "false").lower() == "true"
+
+def _flavor_defines(ctx):
+    return ["DBG=1", "FPO=0"] if _is_checked(ctx) else ["DBG=0", "FPO=1"]
+
+def _flavor_copts(ctx):
+    return ["/cbstring", "/Oy-"] if _is_checked(ctx) else ["/Oy"]
+
+def _variant_defines(ctx, variant):
+    result = []
+    # build.exe deliberately compiles every checked kernel with the MP locking
+    # model, including targets named up/pae.
+    if not _is_checked(ctx) and variant in ["up", "pae"]:
+        result.append("NT_UP=1")
+    # The legacy UP and PAE objects omit SMT scheduling. MP and PAEMP
+    # include it in both Free and Checked builds.
+    if variant in ["mp", "paemp"]:
+        result.append("NT_SMT")
+    if variant in ["pae", "paemp"]:
+        result.append("_X86PAE_")
+    return result
+
+def _source_includes(ctx):
+    return [(ctx.label.workspace_root + "/" + p) if ctx.label.workspace_root else p for p in ctx.attr.includes]
+
+def _quote(value):
+    return "\"%s\"" % value.replace("\"", "\\\"")
+
+def _nt5_cl_objects_impl(ctx):
+    outputs = []
+    used_basenames = {}
+
+    for src in ctx.files.srcs:
+        basename = src.basename.rsplit(".", 1)[0]
+        if basename.lower() in used_basenames:
+            fail("duplicate source basename '%s' is not supported in one target" % basename)
+        used_basenames[basename.lower()] = True
+
+        output = ctx.actions.declare_file("%s.objects/%s.obj" % (ctx.label.name, basename))
+        response = ctx.actions.declare_file("%s.objects/%s.cl.rsp" % (ctx.label.name, basename))
+        response_lines = _FREE_X86_COPTS[:]
+        if not any([opt.upper().startswith("/W") and opt.upper() != "/WX" for opt in ctx.attr.copts]):
+            response_lines.append("/W3")
+        response_lines.extend(_flavor_copts(ctx) + ctx.attr.copts)
+        response_lines.extend(["/D%s" % define for define in _FREE_X86_DEFINES + _flavor_defines(ctx) + _variant_defines(ctx, ctx.attr.variant) + ctx.attr.defines])
+        generated_include_paths = [dep[Nt5IncludeInfo].directory.path for dep in ctx.attr.generated_headers]
+        response_lines.extend(["/I%s" % _quote(path) for path in _source_includes(ctx) + generated_include_paths])
+        pch_inputs = []
+        pch_transitive = []
+        if ctx.attr.pch:
+            pch_info = ctx.attr.pch[Nt5PchInfo]
+            response_lines.extend([
+                "/Yu%s" % pch_info.header_name,
+                "/Fp%s" % _quote(pch_info.pch.path),
+            ])
+            pch_transitive.append(pch_info.files)
+        response_lines.extend([
+            "/Fo%s" % _quote(output.path),
+            _quote(src.path),
+        ])
+        ctx.actions.write(response, "\r\n".join(response_lines) + "\r\n")
+
+        ctx.actions.run(
+            executable = ctx.executable._cl_wrapper,
+            arguments = [ctx.file._cl.dirname, response.path],
+            inputs = depset(
+                direct = [src, response] + ctx.files.hdrs,
+                transitive = [ctx.attr._tool_payload[DefaultInfo].files] + [dep[Nt5IncludeInfo].files for dep in ctx.attr.generated_headers] + pch_transitive,
+            ),
+            outputs = [output],
+            mnemonic = "Nt5LegacyCl",
+            progress_message = "Compiling %s with the NT 5 VC7 x86 compiler" % src.short_path,
+            use_default_shell_env = False,
+        )
+        outputs.append(output)
+
+    object_set = depset(outputs)
+    return [
+        DefaultInfo(files = object_set),
+        Nt5ObjectsInfo(objects = object_set),
+    ]
+
+nt5_cl_objects = rule(
+    implementation = _nt5_cl_objects_impl,
+    attrs = {
+        "srcs": attr.label_list(allow_files = [".c"], mandatory = True),
+        "hdrs": attr.label_list(allow_files = True),
+        "includes": attr.string_list(),
+        "defines": attr.string_list(),
+        "copts": attr.string_list(),
+        "variant": attr.string(default = "up", values = ["up", "mp", "pae", "paemp"]),
+        "generated_headers": attr.label_list(providers = [Nt5IncludeInfo]),
+        "pch": attr.label(providers = [Nt5PchInfo]),
+        "_cl": attr.label(
+            allow_single_file = True,
+            default = Label("//Source/XPSP1/NT/tools/x86:cl.exe"),
+        ),
+        "_cl_wrapper": attr.label(
+            allow_single_file = True,
+            cfg = "exec",
+            default = Label("//bazel/legacy:cl_wrapper.cmd"),
+            executable = True,
+        ),
+        "_tool_payload": attr.label(
+            default = Label("//Source/XPSP1/NT/tools/x86:vc7_x86_payload"),
+        ),
+    },
+)
+
+def _nt5_static_library_impl(ctx):
+    objects = depset(transitive = [dep[Nt5ObjectsInfo].objects for dep in ctx.attr.deps])
+    output = ctx.actions.declare_file(ctx.label.name + ".lib")
+    response = ctx.actions.declare_file(ctx.label.name + ".lib.rsp")
+    response_lines = [
+        "/nologo",
+        "/WX",
+        "/nodefaultlib",
+        "/machine:ix86",
+        "/IGNORE:4010,4037,4039,4065,4070,4078,4087,4089,4198,4221",
+        "/out:%s" % _quote(output.path),
+    ]
+    response_lines.extend([_quote(obj.path) for obj in objects.to_list()])
+    ctx.actions.write(response, "\r\n".join(response_lines) + "\r\n")
+
+    ctx.actions.run(
+        executable = ctx.executable._lib_wrapper,
+        arguments = [ctx.file._lib.dirname, response.path],
+        inputs = depset(
+            direct = [response],
+            transitive = [objects, ctx.attr._tool_payload[DefaultInfo].files],
+        ),
+        outputs = [output],
+        mnemonic = "Nt5LegacyLib",
+        progress_message = "Archiving %{label} with the NT 5 VC7 x86 librarian",
+        use_default_shell_env = False,
+    )
+    return [DefaultInfo(files = depset([output]))]
+
+nt5_static_library = rule(
+    implementation = _nt5_static_library_impl,
+    attrs = {
+        "deps": attr.label_list(
+            mandatory = True,
+            providers = [Nt5ObjectsInfo],
+        ),
+        "_lib": attr.label(
+            allow_single_file = True,
+            default = Label("//Source/XPSP1/NT/tools/x86:lib.exe"),
+        ),
+        "_lib_wrapper": attr.label(
+            allow_single_file = True,
+            cfg = "exec",
+            default = Label("//bazel/legacy:lib_wrapper.cmd"),
+            executable = True,
+        ),
+        "_tool_payload": attr.label(
+            default = Label("//Source/XPSP1/NT/tools/x86:vc7_x86_payload"),
+        ),
+    },
+)
+
+def _nt5_ml_object_impl(ctx):
+    stem = ctx.file.src.basename.rsplit(".", 1)[0]
+    output = ctx.actions.declare_file(ctx.label.name + ".ml-files/" + stem + ".obj")
+    # A number of HAL assembly files are source-level links that include a
+    # same-named file from halx86.  Give the normalized driver file a distinct
+    # basename so MASM resolves that include through /I instead of recursively
+    # opening the generated input itself.
+    normalized_src = ctx.actions.declare_file(ctx.label.name + ".ml-files/input_" + ctx.file.src.basename)
+    ctx.actions.expand_template(
+        template = ctx.file.src,
+        output = normalized_src,
+        substitutions = {
+            "..\\..\\vdm\\i386\\vdm.inc": "vdm.inc",
+            "..\\..\\halx86\\i386\\": "",
+            "..\\..\\halmps\\i386\\": "",
+        },
+    )
+    response = ctx.actions.declare_file(ctx.label.name + ".ml.rsp")
+    lines = [
+        "/nologo",
+        "/c",
+        "/coff",
+        "/Cx",
+        "/Zm",
+        "/Zi",
+    ]
+    lines.extend(["/D%s" % define for define in _FREE_X86_DEFINES + _flavor_defines(ctx) + _variant_defines(ctx, ctx.attr.variant) + ctx.attr.defines])
+    generated_include_paths = [dep[Nt5IncludeInfo].directory.path for dep in ctx.attr.generated_headers]
+    lines.extend(["/I%s" % _quote(path) for path in _source_includes(ctx) + generated_include_paths])
+    lines.extend(["/Fo%s" % _quote(output.path), _quote(normalized_src.path)])
+    ctx.actions.write(response, "\r\n".join(lines) + "\r\n")
+
+    ctx.actions.run(
+        executable = ctx.executable._wrapper,
+        arguments = [ctx.file._ml.dirname, response.path],
+        inputs = depset(
+            direct = [normalized_src, response] + ctx.files.hdrs,
+            transitive = [ctx.attr._tool_payload[DefaultInfo].files] + [dep[Nt5IncludeInfo].files for dep in ctx.attr.generated_headers],
+        ),
+        outputs = [output],
+        mnemonic = "Nt5LegacyMl",
+        progress_message = "Assembling %{label} with the NT 5 x86 MASM",
+        use_default_shell_env = False,
+    )
+    return [DefaultInfo(files = depset([output])), Nt5ObjectsInfo(objects = depset([output]))]
+
+nt5_ml_object = rule(
+    implementation = _nt5_ml_object_impl,
+    attrs = {
+        "src": attr.label(allow_single_file = [".asm", ".s"], mandatory = True),
+        "hdrs": attr.label_list(allow_files = True),
+        "includes": attr.string_list(),
+        "defines": attr.string_list(),
+        "variant": attr.string(default = "up", values = ["up", "mp", "pae", "paemp"]),
+        "generated_headers": attr.label_list(providers = [Nt5IncludeInfo]),
+        "_ml": attr.label(
+            allow_single_file = True,
+            default = Label("//Source/XPSP1/NT/tools/x86:ml.exe"),
+        ),
+        "_wrapper": attr.label(
+            allow_single_file = True,
+            cfg = "exec",
+            default = Label("//bazel/legacy:ml_wrapper.cmd"),
+            executable = True,
+        ),
+        "_tool_payload": attr.label(default = Label("//Source/XPSP1/NT/tools/x86:vc7_x86_payload")),
+    },
+)
+
+def _nt5_prebuilt_objects_impl(ctx):
+    object_set = depset(ctx.files.srcs)
+    return [DefaultInfo(files = object_set), Nt5ObjectsInfo(objects = object_set)]
+
+nt5_prebuilt_objects = rule(
+    implementation = _nt5_prebuilt_objects_impl,
+    attrs = {"srcs": attr.label_list(allow_files = [".obj"], mandatory = True)},
+)
+
+def _nt5_ke_services_objects_impl(ctx):
+    generated = ctx.actions.declare_directory(ctx.label.name + ".services")
+    ctx.actions.run(
+        executable = ctx.executable._generator_wrapper,
+        arguments = [ctx.file._gensrv.dirname, ctx.file.services.path, generated.path, ctx.file.table_stub.dirname],
+        inputs = depset(
+            direct = [ctx.file.services, ctx.file.table_stub, ctx.file.services_stub],
+            transitive = [ctx.attr._tool_payload[DefaultInfo].files],
+        ),
+        outputs = [generated],
+        mnemonic = "Nt5GenServices",
+        progress_message = "Generating x86 system-service tables for %{label}",
+        use_default_shell_env = False,
+    )
+
+    objects = []
+    for stem in ["sysstubs", "systable"]:
+        output = ctx.actions.declare_file(ctx.label.name + ".service-objects/" + stem + ".obj")
+        response = ctx.actions.declare_file(ctx.label.name + ".service-objects/" + stem + ".ml.rsp")
+        lines = ["/nologo", "/c", "/coff", "/Cx", "/Zm", "/Zi"]
+        lines.extend(["/D%s" % define for define in _FREE_X86_DEFINES + _flavor_defines(ctx) + _variant_defines(ctx, ctx.attr.variant) + ctx.attr.defines])
+        generated_include_paths = [dep[Nt5IncludeInfo].directory.path for dep in ctx.attr.generated_headers]
+        lines.extend(["/I%s" % _quote(path) for path in [generated.path] + _source_includes(ctx) + generated_include_paths])
+        lines.extend(["/Fo%s" % _quote(output.path), _quote(generated.path + "/" + stem + ".asm")])
+        ctx.actions.write(response, "\r\n".join(lines) + "\r\n")
+        ctx.actions.run(
+            executable = ctx.executable._ml_wrapper,
+            arguments = [ctx.file._ml.dirname, response.path],
+            inputs = depset(
+                direct = [generated, response] + ctx.files.hdrs,
+                transitive = [ctx.attr._tool_payload[DefaultInfo].files] + [dep[Nt5IncludeInfo].files for dep in ctx.attr.generated_headers],
+            ),
+            outputs = [output],
+            mnemonic = "Nt5LegacyMl",
+            progress_message = "Assembling generated %s for %%{label}" % stem,
+            use_default_shell_env = False,
+        )
+        objects.append(output)
+    object_set = depset(objects)
+    return [DefaultInfo(files = object_set), Nt5ObjectsInfo(objects = object_set)]
+
+nt5_ke_services_objects = rule(
+    implementation = _nt5_ke_services_objects_impl,
+    attrs = {
+        "services": attr.label(allow_single_file = True, mandatory = True),
+        "table_stub": attr.label(allow_single_file = True, mandatory = True),
+        "services_stub": attr.label(allow_single_file = True, mandatory = True),
+        "hdrs": attr.label_list(allow_files = True),
+        "includes": attr.string_list(),
+        "defines": attr.string_list(),
+        "variant": attr.string(default = "up", values = ["up", "mp", "pae", "paemp"]),
+        "generated_headers": attr.label_list(providers = [Nt5IncludeInfo]),
+        "_gensrv": attr.label(allow_single_file = True, default = Label("//Source/XPSP1/NT/tools/x86:gensrv.exe")),
+        "_ml": attr.label(allow_single_file = True, default = Label("//Source/XPSP1/NT/tools/x86:ml.exe")),
+        "_generator_wrapper": attr.label(allow_single_file = True, cfg = "exec", default = Label("//bazel/legacy:ke_services_wrapper.cmd"), executable = True),
+        "_ml_wrapper": attr.label(allow_single_file = True, cfg = "exec", default = Label("//bazel/legacy:ml_wrapper.cmd"), executable = True),
+        "_tool_payload": attr.label(default = Label("//Source/XPSP1/NT/tools/x86:vc7_x86_payload")),
+    },
+)
+
+def _nt5_rc_resource_impl(ctx):
+    stem = ctx.file.src.basename.rsplit(".", 1)[0]
+    output = ctx.actions.declare_file(ctx.label.name + ".rc-files/" + stem + ".res")
+    lines = ["/r"]
+    for define in ctx.attr.defines:
+        lines.extend(["/d", define])
+    generated_include_paths = [dep[Nt5IncludeInfo].directory.path for dep in ctx.attr.generated_headers]
+    for path in _source_includes(ctx) + generated_include_paths:
+        lines.extend(["/i", path])
+    lines.extend(["/fo", output.path, ctx.file.src.path])
+
+    ctx.actions.run(
+        executable = ctx.executable._rc,
+        arguments = lines,
+        inputs = depset(
+            direct = [ctx.file.src] + ctx.files.hdrs,
+            transitive = [ctx.attr._tool_payload[DefaultInfo].files] + [dep[Nt5IncludeInfo].files for dep in ctx.attr.generated_headers],
+        ),
+        outputs = [output],
+        mnemonic = "Nt5LegacyRc",
+        progress_message = "Compiling %{label} with the NT 5 resource compiler",
+        use_default_shell_env = False,
+    )
+    output_set = depset([output])
+    return [DefaultInfo(files = output_set), Nt5ObjectsInfo(objects = output_set)]
+
+nt5_rc_resource = rule(
+    implementation = _nt5_rc_resource_impl,
+    attrs = {
+        "src": attr.label(allow_single_file = [".rc"], mandatory = True),
+        "hdrs": attr.label_list(allow_files = True),
+        "includes": attr.string_list(),
+        "defines": attr.string_list(),
+        "generated_headers": attr.label_list(providers = [Nt5IncludeInfo]),
+        "_rc": attr.label(
+            allow_single_file = True,
+            cfg = "exec",
+            default = Label("//Source/XPSP1/NT/tools/x86:rc.exe"),
+            executable = True,
+        ),
+        "_tool_payload": attr.label(default = Label("//Source/XPSP1/NT/tools/x86:vc7_x86_payload")),
+    },
+)
+
+def _nt5_message_impl(ctx):
+    output_dir = ctx.actions.declare_directory(ctx.label.name + ".mc")
+    args = [
+        "-h",
+        output_dir.path,
+        "-r",
+        output_dir.path,
+    ]
+    args.extend(ctx.attr.options)
+    args.append(ctx.file.src.path)
+
+    ctx.actions.run(
+        executable = ctx.executable._mc,
+        arguments = args,
+        inputs = depset(
+            direct = [ctx.file.src],
+            transitive = [ctx.attr._tool_payload[DefaultInfo].files],
+        ),
+        outputs = [output_dir],
+        mnemonic = "Nt5LegacyMc",
+        progress_message = "Compiling %{label} with the NT 5 message compiler",
+        use_default_shell_env = False,
+    )
+    output_set = depset([output_dir])
+    return [DefaultInfo(files = output_set), Nt5IncludeInfo(directory = output_dir, files = output_set)]
+
+nt5_message = rule(
+    implementation = _nt5_message_impl,
+    attrs = {
