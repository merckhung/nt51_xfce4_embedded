+++ b/bazel/legacy/genlvl_wrapper.cmd
@@ -0,0 +1,8 @@
+@echo off
+setlocal
+for %%I in ("%~1") do set "TOOL=%%~fI"
+for %%I in ("%~2") do set "INPUT_DIR=%%~fI"
