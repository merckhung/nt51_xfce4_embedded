diff --git a/Source/XPSP1/NT/base/boot/bootvid/BUILD.bazel b/Source/XPSP1/NT/base/boot/bootvid/BUILD.bazel
new file mode 100644
--- /dev/null
+++ b/Source/XPSP1/NT/base/boot/bootvid/BUILD.bazel
@@ -0,0 +1,66 @@
+load("//bazel/legacy:nt5_rules.bzl", "nt5_c_library", "nt5_import_library", "nt5_native_dll", "nt5_raw_def_file", "nt5_rc_resource")
+
+package(default_visibility = ["//visibility:public"])
+
+filegroup(
+    name = "headers",
+    srcs = glob(["*.h"]),
+)
+
+_HDRS = [
+    ":headers",
+    "//Source/XPSP1/NT/base/ntos/inc:headers",
+    "//Source/XPSP1/NT/public/ddk/inc:headers",
+    "//Source/XPSP1/NT/public/halkit/inc:headers",
+    "//Source/XPSP1/NT/public/internal/base/inc:headers",
+    "//Source/XPSP1/NT/public/sdk/inc:headers",
+]
+
+_INCLUDES = [
+    "Source/XPSP1/NT/base/boot/bootvid",
+    "Source/XPSP1/NT/base/ntos/inc",
+    "Source/XPSP1/NT/public/ddk/inc",
+    "Source/XPSP1/NT/public/halkit/inc",
+    "Source/XPSP1/NT/public/internal/base/inc",
+    "Source/XPSP1/NT/public/sdk/inc",
+    "Source/XPSP1/NT/public/sdk/inc/crt",
+]
+
+nt5_c_library(
+    name = "bootvid_objects",
+    srcs = ["bootvid.c", "bootdata.c", "vga.c"],
+    hdrs = _HDRS,
+    includes = _INCLUDES,
+)
+
+nt5_raw_def_file(
+    name = "bootvid_def",
+    src = "bootvid.def",
+)
+
+nt5_import_library(
+    name = "bootvid",
+    definition = ":bootvid_def",
+    resolution_libraries = [":bootvid_objects"],
+)
+
+nt5_rc_resource(
+    name = "bootvid_resource",
+    src = "bootvid.rc",
+    hdrs = _HDRS,
+    includes = _INCLUDES,
+)
+
+nt5_native_dll(
+    name = "bootvid_image",
+    image_name = "bootvid.dll",
+    exports = ":bootvid",
+    resources = [":bootvid_resource"],
+    libraries = [
+        ":bootvid_objects",
+        "//Source/XPSP1/NT/base/hals/halacpi/picacpi:hal",
+        "//Source/XPSP1/NT/base/ntos:ntoskrnl_exports",
+    ],
+)
+
+filegroup(name="source_tree",srcs=glob(["**"],exclude=["BUILD.bazel"]),visibility=["//visibility:public"])
