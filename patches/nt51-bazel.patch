+def _nt5_pch_impl(ctx):
+    # Preserve the legacy companion object basename (for example cc.obj).  The
+    # librarian records this basename in the archive member table, so naming
+    # the file after the Bazel target would prevent byte-level graph parity.
+    stem = ctx.file.header.basename.rsplit(".", 1)[0]
+    pch = ctx.actions.declare_file(ctx.label.name + ".pch-files/" + stem + ".pch")
+    obj = ctx.actions.declare_file(ctx.label.name + ".pch-files/" + stem + ".obj")
+    source = ctx.actions.declare_file(ctx.label.name + ".pch.c")
+    response = ctx.actions.declare_file(ctx.label.name + ".pch.rsp")
+    ctx.actions.write(source, '#include "%s"\r\n' % ctx.file.header.basename)
+
+    lines = _FREE_X86_COPTS[:]
+    if not any([opt.upper().startswith("/W") and opt.upper() != "/WX" for opt in ctx.attr.copts]):
+        lines.append("/W3")
+    lines.extend(_flavor_copts(ctx) + ctx.attr.copts)
+    lines.extend(["/D%s" % define for define in _FREE_X86_DEFINES + _flavor_defines(ctx) + _variant_defines(ctx, ctx.attr.variant) + ctx.attr.defines])
+    generated_include_paths = [dep[Nt5IncludeInfo].directory.path for dep in ctx.attr.generated_headers]
+    lines.extend(["/I%s" % _quote(path) for path in _source_includes(ctx) + generated_include_paths])
+    lines.extend([
+        "/Yl%s" % ctx.attr.symbol_name,
+        "/Yc%s" % ctx.file.header.basename,
+        "/Fp%s" % _quote(pch.path),
+        "/Fo%s" % _quote(obj.path),
+        "/Tc%s" % _quote(source.path),
+    ])
+    ctx.actions.write(response, "\r\n".join(lines) + "\r\n")
+
+    ctx.actions.run(
+        executable = ctx.executable._cl_wrapper,
+        arguments = [ctx.file._cl.dirname, response.path],
+        inputs = depset(
+            direct = [ctx.file.header, source, response] + ctx.files.hdrs,
+            transitive = [ctx.attr._tool_payload[DefaultInfo].files] + [dep[Nt5IncludeInfo].files for dep in ctx.attr.generated_headers],
+        ),
+        outputs = [pch, obj],
+        mnemonic = "Nt5LegacyPch",
+        progress_message = "Creating VC7 precompiled header for %{label}",
+        use_default_shell_env = False,
+    )
+    output_set = depset([pch, obj])
+    return [
+        DefaultInfo(files = output_set),
+        Nt5ObjectsInfo(objects = depset([obj])),
+        Nt5PchInfo(header_name = ctx.file.header.basename, pch = pch, files = output_set),
+    ]
+
+nt5_pch = rule(
+    implementation = _nt5_pch_impl,
+    attrs = {
+        "header": attr.label(allow_single_file = True, mandatory = True),
+        "symbol_name": attr.string(mandatory = True),
+        "hdrs": attr.label_list(allow_files = True),
+        "includes": attr.string_list(),
+        "defines": attr.string_list(),
+        "copts": attr.string_list(),
+        "variant": attr.string(default = "up", values = ["up", "mp", "pae", "paemp"]),
+        "generated_headers": attr.label_list(providers = [Nt5IncludeInfo]),
+        "_cl": attr.label(allow_single_file = True, default = Label("//Source/XPSP1/NT/tools/x86:cl.exe")),
+        "_cl_wrapper": attr.label(
+            allow_single_file = True,
+            cfg = "exec",
+            default = Label("//bazel/legacy:cl_wrapper.cmd"),
+            executable = True,
+        ),
+        "_tool_payload": attr.label(default = Label("//Source/XPSP1/NT/tools/x86:vc7_x86_payload")),
