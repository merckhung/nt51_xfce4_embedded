+def nt5_c_library(name, srcs, hdrs = [], includes = [], defines = [], copts = [], generated_headers = [], extra_object_deps = [], pch_header = None, pch_symbol_name = None, variant = "up", visibility = None):
+    """Compiles C sources and archives them with the original x86 tools."""
+    objects_name = name + "_objects"
+    pch_target = None
+    if pch_header:
+        pch_target = name + "_pch"
+        nt5_pch(
+            name = pch_target,
+            header = pch_header,
+            symbol_name = pch_symbol_name or name,
+            hdrs = hdrs,
+            includes = includes,
+            defines = defines,
+            copts = copts,
+            generated_headers = generated_headers,
+            variant = variant,
+            visibility = ["//visibility:private"],
+        )
+
+    nt5_cl_objects(
+        name = objects_name,
+        srcs = srcs,
+        hdrs = hdrs,
+        includes = includes,
+        defines = defines,
+        copts = copts,
+        generated_headers = generated_headers,
+        variant = variant,
+        pch = (":" + pch_target) if pch_target else None,
+        visibility = ["//visibility:private"],
+    )
+    nt5_static_library(
+        name = name,
+        deps = [":" + objects_name] + ([":" + pch_target] if pch_target else []) + extra_object_deps,
+        visibility = visibility,
+    )
+
+def nt5_mixed_library(name, c_srcs = [], asm_srcs = [], prebuilt_objects = [], extra_object_deps = [], hdrs = [], includes = [], defines = [], copts = [], generated_headers = [], pch_header = None, pch_symbol_name = None, variant = "up", visibility = None):
+    """Builds a legacy archive from C, MASM, and preserved binary objects."""
+    deps = extra_object_deps[:]
+    pch_target = None
+    if pch_header:
+        pch_target = name + "_pch"
+        nt5_pch(
+            name = pch_target,
+            header = pch_header,
+            symbol_name = pch_symbol_name or name,
+            hdrs = hdrs,
+            includes = includes,
+            defines = defines,
+            copts = copts,
+            generated_headers = generated_headers,
+            variant = variant,
+            visibility = ["//visibility:private"],
+        )
+        deps.append(":" + pch_target)
+    if c_srcs:
+        c_name = name + "_c_objects"
+        nt5_cl_objects(
+            name = c_name,
+            srcs = c_srcs,
+            hdrs = hdrs,
+            includes = includes,
+            defines = defines,
+            copts = copts,
+            generated_headers = generated_headers,
+            variant = variant,
+            pch = (":" + pch_target) if pch_target else None,
+            visibility = ["//visibility:private"],
+        )
+        deps.append(":" + c_name)
+    for index, src in enumerate(asm_srcs):
+        asm_name = "%s_asm_%s" % (name, index)
+        nt5_ml_object(
+            name = asm_name,
+            src = src,
+            hdrs = hdrs,
+            includes = includes,
+            defines = defines,
+            generated_headers = generated_headers,
+            variant = variant,
+            visibility = ["//visibility:private"],
+        )
+        deps.append(":" + asm_name)
+    if prebuilt_objects:
+        seed_name = name + "_binary_objects"
+        nt5_prebuilt_objects(
+            name = seed_name,
+            srcs = prebuilt_objects,
+            visibility = ["//visibility:private"],
+        )
+        deps.append(":" + seed_name)
+    nt5_static_library(name = name, deps = deps, visibility = visibility)
+
+# Backward-compatible name used by the initial smoke target.
+def nt5_cl_object(name, src, visibility = None):
